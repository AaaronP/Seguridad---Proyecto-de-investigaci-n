FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /rollup-lab

# Copiamos los archivos del atacante
COPY src/ ./src/
COPY build.js .
COPY package.json .

RUN tar -czvf paquete-malicioso.tar.gz src build.js package.json
